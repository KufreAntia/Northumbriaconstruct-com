# Set real secrets through Vercel environment settings, never commit them.
ANALYTICS_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ANALYTICS_ADMIN_USER=admin
# At least 32 random characters, kept in your password manager.
ANALYTICS_ADMIN_PASSWORD=
# Server-only Vercel token scoped to the owning team; not a deployment bypass token.
VERCEL_ANALYTICS_READ_TOKEN=
ANALYTICS_VERCEL_PROJECT_ID=
ANALYTICS_VERCEL_TEAM_ID=
